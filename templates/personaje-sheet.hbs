<form class="{{cssClass}} mystery-paper-theme" autocomplete="off">

    {{!-- CABECERA DE NAVEGACIÓN (PESTAÑAS + MINI CONTROLES DE DESCANSO) --}}
    <div class="sheet-top-bar">
        <div class="top-bar-spacer"></div>

        <nav class="sheet-tabs tabs" data-group="primary">
            <a class="item" data-tab="expediente"><i class="fas fa-scroll"></i> Expediente</a>
            <a class="item" data-tab="baraja"><i class="fas fa-layer-group"></i> Baraja y Equipo</a>
        </nav>

        <div class="rest-controls-mini">
            <button type="button" class="btn-dormir" title="Dormir: Recupera +1 Salud, 1d4+2 Estabilidad y hasta 3 Habilidades Generales">
                <i class="fas fa-moon"></i> Dormir
            </button>
            <button type="button" class="btn-recuperacion-total" title="Recuperación Total (Cambio de capítulo)">
                <i class="fas fa-fire-alt"></i> Cap.
            </button>
        </div>
    </div>

    <section class="sheet-body">

        {{!-- PESTAÑA 1: EXPEDIENTE --}}
        <div class="tab" data-group="primary" data-tab="expediente">


            {{!-- PARTE SUPERIOR: Dados, Runas y Retrato --}}
            <header class="sheet-upper flexrow">

                {{!-- Dados Atributos --}}
                <div class="dice-column flexcol">
                    {{#each system.atributos as |dado key|}}
                    <div class="dice-row flexrow">
                        <span class="attribute-label">{{key}}</span>
                        <div class="dice-icon-wrap">
                            <a class="tirar-atributo" data-atributo="{{key}}" title="Tirar {{key}}">
                                <img src="systems/dorso_oscuro/assets/{{dado}}.png" class="img-dado" />
                            </a>
                            <a class="cambiar-dado btn-editar-dado" data-atributo="{{key}}" title="Cambiar dado de {{key}}">
                                <i class="fas fa-pen-fancy"></i>
                            </a>
                        </div>
                    </div>
                    {{/each}}
                </div>

                {{!-- Decoración Rúnica --}}
                <div class="rune-separator">
                    <img src="systems/dorso_oscuro/assets/runa_central.png">
                </div>

                {{!-- Nombre y Foto Circular --}}
                <div class="portrait-column flexcol">
                    <h1 class="charname">
                        <input name="name" type="text" value="{{actor.name}}" placeholder="Nombre" />
                    </h1>
                    <div class="portrait-container">
                        <img class="profile-img-circle" src="{{actor.img}}" data-edit="img" title="Cambiar retrato" />
                    </div>
                </div>
            </header>

            {{!-- PARTE MEDIA: Stats en cuadrícula 2x2 + Umbral y Esencia --}}
            <section class="stats-mid flexrow">

                <div class="track-stats-grid">
                    <div class="stat-card">
                        <span class="stat-label"><i class="fas fa-heart stat-icon-hp"></i> Salud</span>
                        <div class="stat-inputs">
                            <input type="number" name="system.hp.value" value="{{system.hp.value}}" class="stat-val-main">
                            <span class="value-separator">/</span>
                            <input type="number" name="system.hp.max" value="{{system.hp.max}}" class="stat-val-max" title="Salud Máxima">
                        </div>
                    </div>

                    <div class="stat-card">
                        <span class="stat-label"><i class="fas fa-balance-scale stat-icon-est"></i> Estabilidad</span>
                        <div class="stat-inputs">
                            <input type="number" name="system.estabilidad" value="{{system.estabilidad}}" class="stat-val-main">
                            <span class="value-separator">/</span>
                            <input type="number" name="system.estabilidadMax" value="{{system.estabilidadMax}}" class="stat-val-max" title="Estabilidad Máxima">
                        </div>
                    </div>

                    <div class="stat-card">
                        <span class="stat-label"><i class="fas fa-brain stat-icon-cor"></i> Cordura</span>
                        <div class="stat-inputs">
                            <input type="number" name="system.cordura" value="{{system.cordura}}" class="stat-val-main">
                            <span class="value-separator">/</span>
                            <input type="number" name="system.corduraMax" value="{{system.corduraMax}}" class="stat-val-max" title="Cordura Máxima">
                        </div>
                    </div>

                    <div class="stat-card">
                        <span class="stat-label"><i class="fas fa-coins stat-icon-cred"></i> Crédito</span>
                        <div class="stat-inputs">
                            <input type="number" name="system.credito" value="{{system.credito}}" class="stat-val-main stat-val-single">
                        </div>
                    </div>
                </div>

                <div class="icon-stats flexrow">
                    <div class="icon-group">
                        <label>Umbral</label>
                        <div class="icon-frame umbral-frame">
                            <input type="number" name="system.umbral" value="{{system.umbral}}">
                        </div>
                    </div>
                    <div class="icon-group">
                        <label>Esencia</label>
                        <div class="icon-frame esencia-frame">
                            <input type="number" name="system.esencia" value="{{system.esencia}}">
                        </div>
                    </div>
                </div>
            </section>

            {{!-- PARTE INFERIOR: Dos Columnas de Habilidades --}}
            <section class="skills-grid flexrow">
                {{!-- Columna Técnicas --}}
                <div class="skill-column">
                    <h3><i class="fas fa-compass"></i> Habilidades Técnicas</h3>
                    {{> "systems/dorso_oscuro/templates/parts/skill-list.hbs" skills=habilidadesTecnicas}}
                </div>

                {{!-- Columna Generales --}}
                <div class="skill-column">
                    <h3><i class="fas fa-running"></i> Habilidades Generales</h3>
                    {{> "systems/dorso_oscuro/templates/parts/skill-list.hbs" skills=habilidadesGenerales}}
                </div>
            </section>

            {{!-- PIE: Armas y Notas --}}
            <footer class="sheet-footer flexrow">

                <div class="footer-box armas flexcol">
                    <h3><i class="fas fa-briefcase"></i> Inventario</h3>

                    <div class="parchment-panel">
                        <ul class="skills-list inventory-list flexcol">

                            {{!-- Listado de Armas --}}
                            {{#each armas as |item|}}
                            <li class="item inventory-row flexrow" data-item-id="{{item._id}}">
                                <div class="inventory-main flexrow">
                                    <img src="{{item.img}}" class="inventory-thumb">
                                    <span class="inventory-name">{{item.name}}</span>
                                    <span class="inventory-tag tag-weapon">Daño {{item.system.danio}}</span>
                                </div>

                                <div class="item-controls inventory-actions flexrow">
                                    <a class="arma-roll btn-attack-weapon" title="Atacar con {{item.name}}">
                                        <i class="fas fa-crosshairs"></i>
                                    </a>
                                    <a class="item-edit" title="Ver Ficha">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    {{#if @root.user.isGM}}
                                    <a class="item-delete" title="Borrar Arma">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                    {{/if}}
                                </div>
                            </li>
                            {{/each}}

                            {{!-- Listado de Objetos --}}
                            {{#each objetos as |item|}}
                            <li class="item inventory-row flexrow" data-item-id="{{item._id}}">
                                <div class="inventory-main flexrow">
                                    <img src="{{item.img}}" class="inventory-thumb">
                                    <span class="inventory-name">{{item.name}}</span>
                                    <span class="inventory-tag tag-object">Objeto</span>
                                </div>

                                <div class="item-controls inventory-actions flexrow">
                                    <a class="item-edit" title="Ver Ficha">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    {{#if @root.user.isGM}}
                                    <a class="item-delete" title="Borrar Objeto">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                    {{/if}}
                                </div>
                            </li>
                            {{/each}}

                            {{!-- Mensaje si el inventario está vacío --}}
                            {{#unless armas.length}}
                            {{#unless objetos.length}}
                            <div class="empty-placeholder">Inventario vacío...</div>
                            {{/unless}}
                            {{/unless}}

                        </ul>
                    </div>
                </div>

                <div class="footer-box notas flexcol">
                    <h3><i class="fas fa-feather-alt"></i> Notas</h3>
                    <div class="parchment-panel notes-editor-panel">
                        {{editor enrichedNotas target="system.notas" button=true owner=owner editable=true
                        engine="prosemirror" collaborate=false}}
                    </div>
                </div>
            </footer>


        </div>

        <div class="tab" data-group="primary" data-tab="baraja">
            <div class="deck-container flexcol" style="gap: 20px;">
                <button class="open-hud-btn" type="button" style=" margin-bottom: 10px; background: #4a3424; color:
                    white;">
                    <i class="fas fa-play"></i> ENTRAR EN COMBATE (Abrir Mesa)
                </button>
                {{!-- 1. FILA SUPERIOR: ALMAS Y BANQUILLO --}}
                <div class="flexrow" style="gap: 20px; align-items: flex-start;">

                    {{!-- ALMAS (Izquierda) --}}
                    <div class="deck-section" style="flex: 2;">
                        <h3 style="border-bottom: 2px solid #4a3424; margin-bottom: 10px;">Almas Disponibles</h3>
                        <ul class="skills-list flexcol" style="gap: 5px;">
                            {{#each cartasAlma as |carta|}}
                            <li class="item skill-row" data-item-id="{{carta._id}}" style="padding: 5px 0;">
                                <div class="skill-main-info flexrow">
                                    {{!-- CLASE card-thumbnail aplicada, eliminados width/height inline --}}
                                    <img src="{{carta.img}}" class="card-thumbnail">
                                    <h4 class="skill-name" style="margin:0; font-size: 18px;">{{carta.name}}</h4>
                                    <span class="skill-attr"
                                        style="margin-left: 10px;">[{{carta.system.elemento}}]</span>
                                </div>
                                <div class="item-controls flexrow"
                                    style="align-items: center; justify-content: flex-end; gap: 10px;">
                                    <a class="item-edit" title="Ver Carta"><i class="fas fa-eye"></i></a>
                                    {{#if @root.user.isGM}}
                                    <a class="item-delete" title="Borrar Alma" style="color: #8b0000;"><i
                                            class="fas fa-trash"></i></a>
                                    {{/if}}
                                </div>
                            </li>
                            {{/each}}
                        </ul>
                    </div>

                    {{!-- BANQUILLO (Derecha) --}}
                    <div class="deck-section"
                        style="flex: 1; border: 2px dashed #666; padding: 10px; background: rgba(0,0,0,0.03); border-radius: 8px;">
                        <h3 style="border-bottom: 2px solid #666; margin-bottom: 10px; text-align: center;">Banquillo
                            (Máx 3)</h3>
                        <ul class="skills-list flexcol" style="gap: 8px;">
                            {{#each banquillo as |carta|}}
                            <li class="item flexrow" data-item-id="{{carta._id}}"
                                style="align-items: center; background: #eee; padding: 5px 8px; border-radius: 4px; border: 1px solid #ccc;">
                                <img src="{{carta.img}}" width="20" height="30"
                                    style="margin-right: 8px; border-radius: 2px; filter: grayscale(100%); object-fit: cover;">
                                <span style="font-size: 14px; flex: 1; line-height: 1.1;">{{carta.name}}</span>
                                <div class="item-controls flexrow" style="flex: 0 0 auto; gap: 8px;">
                                    <a class="item-edit" title="Ver Carta" style="color: #444;"><i
                                            class="fas fa-eye"></i></a>
                                    <a class="item-toggle-bench" title="Sacar del Banquillo" style="color: #4a3424;"><i
                                            class="fas fa-hand-holding-magic"></i></a>
                                </div>
                            </li>
                            {{/each}}
                        </ul>
                    </div>
                </div>



                {{!-- 2. FILA MEDIA: OBJETOS (Ancho completo) --}}
                <div class="deck-section">
                    <h3 style="border-bottom: 2px solid #884400; margin-bottom: 10px;">Objetos Activos</h3>
                    {{!-- Usamos un grid para que si hay varios objetos se pongan en cajitas --}}
                    <ul class="skills-list"
                        style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px;">
                        {{#each barajaObjetos as |carta|}}
                        <li class="item skill-row" data-item-id="{{carta._id}}"
                            style="padding: 5px; border: 1px solid rgba(0,0,0,0.1); background: rgba(255,255,255,0.3); border-radius: 4px;">
                            <div class="skill-main-info flexrow">
                                {{!-- CLASE card-thumbnail aplicada --}}
                                <img src="{{carta.img}}" class="card-thumbnail">
                                <span class="skill-name"
                                    style="font-weight: bold; font-size: 16px;">{{carta.name}}</span>
                            </div>
                            <div class="item-controls flexrow"
                                style="align-items: center; justify-content: flex-end; gap: 10px;">
                                <a class="item-toggle-bench" title="Al Banquillo"><i class="fas fa-suitcase"></i></a>
                                <a class="item-edit" title="Ver Carta"><i class="fas fa-eye"></i></a>
                                {{#if @root.user.isGM}}
                                <a class="item-delete" title="Borrar Objeto" style="color: #8b0000;"><i
                                        class="fas fa-trash"></i></a>
                                {{/if}}
                            </div>
                        </li>
                        {{/each}}
                    </ul>
                </div>

                {{!-- 3. FILA INFERIOR: PODERES (Ancho completo a DOS COLUMNAS) --}}
                <div class="deck-section">
                    <h3 style="border-bottom: 2px solid #004488; margin-bottom: 10px;">Poderes Activos
                        ({{barajaPoderes.length}})</h3>
                    {{!-- GRID DE 2 COLUMNAS para optimizar las 30 cartas --}}
                    <ul class="skills-list"
                        style="display: grid; grid-template-columns: 1fr 1fr; gap: x 15px; column-gap: 30px;">
                        {{#each barajaPoderes as |carta|}}
                        <li class="item skill-row" data-item-id="{{carta._id}}" style="padding: 4px 0;">
                            <div class="skill-main-info flexrow">
                                {{!-- CLASE card-thumbnail aplicada --}}
                                <img src="{{carta.img}}" class="card-thumbnail">
                                <span class="skill-name" style="font-size: 16px;">{{carta.name}}</span>
                            </div>
                            <div class="item-controls flexrow"
                                style="align-items: center; justify-content: flex-end; gap: 10px;">
                                <a class="item-toggle-bench" title="Al Banquillo"><i class="fas fa-suitcase"></i></a>
                                <a class="item-edit" title="Ver Carta"><i class="fas fa-eye"></i></a>
                                {{#if @root.user.isGM}}
                                <a class="item-delete" title="Borrar Poder" style="color: #8b0000;"><i
                                        class="fas fa-trash"></i></a>
                                {{/if}}
                            </div>
                        </li>
                        {{/each}}
                    </ul>
                </div>
                {{!-- --- NUEVO: 4. FILA FINAL: EQUIPO GLOBAL DESCUBIERTO --- --}}
                {{#if equipoDisponible.length}}
                <div class="deck-section" style="margin-top: 25px; border-top: 2px dashed #00ccff; padding-top: 15px;">
                    <h3 style="border-bottom: 2px solid #00ccff; margin-bottom: 10px; color: #007799;">
                        <i class="fas fa-shield-alt"></i> Equipo Global Disponible
                    </h3>
                    <ul class="skills-list" style="display: flex; flex-wrap: wrap; gap: 10px;">
                        {{#each equipoDisponible as |eq|}}
                        <li class="item flexrow"
                            style="align-items: center; background: rgba(0, 204, 255, 0.05); padding: 5px 10px; border-radius: 5px; border: 1px solid rgba(0, 204, 255, 0.3); width: auto; min-width: 220px; flex: 1;">

                            {{!-- Miniatura controlada para que horizontales y verticales queden igual de bien --}}
                            <img src="{{eq.img}}"
                                style="height: 40px; width: 60px; object-fit: contain; border-radius: 3px; border: 1px solid #00ccff; margin-right: 10px;">

                            <span
                                style="font-size: 14px; font-weight: bold; color: #1a1a1a; flex: 1;">{{eq.name}}</span>

                            <div class="item-controls flexrow" style="flex: 0 0 auto; margin-left: 10px;">
                                {{!-- El botón del ojo sigue usando la clase que pusimos en el .mjs --}}
                                <a class="item-edit-global" title="Consultar Carta" data-item-id="{{eq.id}}"
                                    style="color: #007799; cursor: pointer;">
                                    <i class="fas fa-eye" style="font-size: 16px;"></i>
                                </a>
                            </div>
                        </li>
                        {{/each}}
                    </ul>
                </div>
                {{/if}}

            </div>
        </div>

    </section>
</form>