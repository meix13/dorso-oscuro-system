<ul class="skills-list flexcol">
    {{#each skills as |item|}}
        <li class="item skill-row flexrow" data-item-id="{{item._id}}">

            <div class="skill-main-info flexrow tirar-habilidad" title="Lanzar {{item.name}}">
                {{!-- BOTÓN PARA LANZAR (DADO) --}}
                <span class="skill-dice-icon">
                    <i class="fas fa-dice-d20"></i>
                </span>

                <span class="skill-name">{{item.name}}</span>
                <span class="skill-attr">[{{item.system.atributoBase}}]</span>
            </div>

            <div class="skill-values flexrow">
                <div class="skill-pool-pill">
                    <input type="number" data-edit="system.valorActual" value="{{item.system.valorActual}}" min="0" max="{{item.system.valorMax}}" class="skill-val-input">
                    <span class="value-max"><span class="value-separator">/</span>{{item.system.valorMax}}</span>
                </div>

                <div class="skill-row-actions flexrow">
                    {{!-- BOTÓN PARA EDITAR (LÁPIZ) --}}
                    <a class="item-edit" title="Editar Habilidad">
                        <i class="fas fa-pen"></i>
                    </a>

                    {{!-- LA PAPELERA: SOLO VISIBLE PARA EL DJ --}}
                    {{#if @root.user.isGM}}
                        <a class="item-delete" title="Borrar Habilidad">
                            <i class="fas fa-trash"></i>
                        </a>
                    {{/if}}
                </div>
            </div>

        </li>
    {{/each}}
</ul>