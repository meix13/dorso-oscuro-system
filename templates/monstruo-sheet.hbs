<form class="{{cssClass}} mystery-paper-theme npc-sheet-form" autocomplete="off">

    <img src="systems/dorso_oscuro/assets/esquina_monstruo.png" class="npc-corner-ornament" alt="" />

    {{!-- BARRA SUPERIOR: TÍTULO DE EXPEDIENTE DE CRIATURA / PNJ Y MUNDO --}}
    <div class="sheet-top-bar npc-top-bar">
        <div class="top-bar-spacer"></div>

        <div class="npc-header-title">
            <i class="fas fa-skull-crossbones"></i> Expediente de PNJ / Criatura
        </div>

        <div class="npc-world-badge" title="Mundo o Dominio al que pertenece">
            <i class="fas fa-globe"></i>
            <select name="system.mundo" {{#unless isGM}}disabled{{/unless}}>
                {{selectOptions config.mundos selected=system.mundo}}
            </select>
        </div>
    </div>

    <section class="sheet-body npc-sheet-body">

        {{!-- PARTE SUPERIOR: Atributos (Físico y Perseguir), Runa Central y Retrato --}}
        <header class="sheet-upper npc-upper flexrow">

            {{!-- Columna Izquierda: Atributos con Dado y Modificador --}}
            <div class="dice-column npc-dice-column flexcol">

                {{!-- FÍSICO --}}
                <div class="dice-row npc-dice-row flexrow">
                    <a class="rollable npc-attr-roll" data-atributo="fisico" title="Lanzar tirada de Físico">
                        <i class="fas fa-dice-d20"></i>
                        <span class="attribute-label">Físico</span>
                    </a>

                    <div class="npc-attr-controls flexrow">
                        <div class="npc-mod-box" title="Modificador de Físico">
                            <span class="npc-mod-sign">+</span>
                            <input type="number" name="system.fisico.mod" value="{{system.fisico.mod}}" />
                        </div>

                        <div class="dice-icon-wrap npc-dice-select-wrap" title="Cambiar dado de Físico">
                            <img src="systems/dorso_oscuro/assets/{{system.fisico.dado}}.png" class="img-dado" alt="{{system.fisico.dado}}" />
                            <select name="system.fisico.dado" class="npc-dice-native-select">
                                {{selectOptions config.opcionesDado selected=system.fisico.dado}}
                            </select>
                            <span class="btn-editar-dado"><i class="fas fa-pen-fancy"></i></span>
                        </div>
                    </div>
                </div>

                {{!-- PERSEGUIR --}}
                <div class="dice-row npc-dice-row flexrow">
                    <a class="rollable npc-attr-roll" data-atributo="perseguir" title="Lanzar tirada de Perseguir">
                        <i class="fas fa-dice-d20"></i>
                        <span class="attribute-label">Perseguir</span>
                    </a>

                    <div class="npc-attr-controls flexrow">
                        <div class="npc-mod-box" title="Modificador de Perseguir">
                            <span class="npc-mod-sign">+</span>
                            <input type="number" name="system.perseguir.mod" value="{{system.perseguir.mod}}" />
                        </div>

                        <div class="dice-icon-wrap npc-dice-select-wrap" title="Cambiar dado de Perseguir">
                            <img src="systems/dorso_oscuro/assets/{{system.perseguir.dado}}.png" class="img-dado" alt="{{system.perseguir.dado}}" />
                            <select name="system.perseguir.dado" class="npc-dice-native-select">
                                {{selectOptions config.opcionesDado selected=system.perseguir.dado}}
                            </select>
                            <span class="btn-editar-dado"><i class="fas fa-pen-fancy"></i></span>
                        </div>
                    </div>
                </div>

            </div>

            {{!-- Centro: Runa Central --}}
            <div class="rune-separator">
                <img src="systems/dorso_oscuro/assets/runa_central.png" alt="" />
            </div>

            {{!-- Columna Derecha: Nombre y Retrato con botón de ampliar --}}
            <div class="portrait-column flexcol">
                <h1 class="charname">
                    <input name="name" type="text" value="{{actor.name}}" placeholder="Nombre del PNJ / Criatura" />
                </h1>
                <div class="portrait-container npc-portrait-container">
                    <img src="{{actor.img}}" data-edit="img" title="Pincha para cambiar imagen" class="profile-img-circle monster-portrait-circle" />
                    <a class="show-portrait btn-ver-retrato" title="Ver arte en grande / Compartir con Jugadores">
                        <i class="fas fa-eye"></i>
                    </a>
                </div>
            </div>

        </header>

        {{!-- PARTE MEDIA: Protección y Razonable + Umbral y Vida/Esencia --}}
        <section class="stats-mid npc-stats-mid flexrow">

            <div class="track-stats-grid npc-track-stats-grid">
                <div class="stat-card">
                    <span class="stat-label"><i class="fas fa-shield-alt stat-icon-est"></i> Protección</span>
                    <div class="stat-inputs">
                        <input type="number" name="system.proteccion" value="{{system.proteccion}}" class="stat-val-main stat-val-single" />
                    </div>
                </div>

                <div class="stat-card">
                    <span class="stat-label"><i class="fas fa-comments stat-icon-cor"></i> Razonable</span>
                    <div class="stat-inputs" title="Nivel de Razonable (0 a 3)">
                        <input type="number" name="system.razonable" value="{{system.razonable}}" min="0" max="3" class="stat-val-main" />
                        <span class="value-separator">/</span>
                        <span class="stat-val-max" style="display:inline-flex; align-items:center; justify-content:center;">3</span>
                    </div>
                </div>
            </div>

            <div class="icon-stats flexrow">
                <div class="icon-group" title="Umbral de Daño">
                    <label>Umbral</label>
                    <div class="icon-frame umbral-frame">
                        <input type="number" name="system.umbral" value="{{system.umbral}}" />
                    </div>
                </div>
                <div class="icon-group" title="Salud / Esencia">
                    <label>Salud</label>
                    <div class="icon-frame esencia-frame">
                        <input type="number" name="system.hp.value" value="{{system.hp.value}}" />
                    </div>
                </div>
            </div>

        </section>

        {{!-- PARTE INFERIOR: ATAQUES Y DESCRIPCIÓN / LORE --}}
        <section class="npc-lower-sections flexcol">

            {{!-- SECCIÓN 1: ATAQUES --}}
            <div class="skill-column npc-section-box">
                <div class="npc-section-header flexrow">
                    <h3><i class="fas fa-crosshairs"></i> Ataques y Acciones</h3>
                    {{#if isGM}}
                    <div class="npc-header-actions flexrow">
                        <a class="ataque-toggle-edit npc-action-pill" title="Alternar Modo Edición">
                            <i class="fas {{#if editModeAtaques}}fa-check{{else}}fa-edit{{/if}}"></i>
                            {{#if editModeAtaques}}Listo{{else}}Editar Ataques{{/if}}
                        </a>
                        {{#if editModeAtaques}}
                        <a class="ataque-create npc-action-pill npc-action-pill-add" title="Añadir nuevo ataque">
                            <i class="fas fa-plus-circle"></i> Añadir Ataque
                        </a>
                        {{/if}}
                    </div>
                    {{/if}}
                </div>

                <div class="ataques-list npc-attacks-list flexcol">
                    {{#each system.ataques as |ataque index|}}
                    <div class="ataque-item npc-attack-card">
                        {{#if @root.editModeAtaques}}
                            {{!-- MODO EDICIÓN (SOLO DJ) --}}
                            <div class="npc-attack-edit-top flexrow">
                                <input type="text" name="system.ataques.{{index}}.nombre" value="{{ataque.nombre}}" placeholder="Nombre del Ataque" class="npc-attack-name-input" />
                                <select name="system.ataques.{{index}}.tipo" class="parchment-select npc-attack-type-select">
                                    {{selectOptions @root.config.tiposAtaque selected=ataque.tipo}}
                                </select>
                                <a class="ataque-delete npc-attack-delete-btn" data-index="{{index}}" title="Borrar Ataque">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>

                            <div class="npc-attack-edit-formulas flexrow">
                                <div class="npc-formula-group flexrow">
                                    <label><i class="fas fa-crosshairs"></i> Impacto:</label>
                                    <input type="text" name="system.ataques.{{index}}.formulaAtaque" value="{{ataque.formulaAtaque}}" placeholder="1d6+2" />
                                    <a class="roll-formula npc-roll-btn-impact" data-formula="{{ataque.formulaAtaque}}" data-nombre="{{ataque.nombre}}" data-especial="{{ataque.especial}}" data-tipo="Impacto" title="Probar Tirada de Impacto">
                                        <i class="fas fa-dice-d20"></i>
                                    </a>
                                </div>

                                <div class="npc-formula-group flexrow">
                                    <label><i class="fas fa-tint"></i> Daño:</label>
                                    <input type="text" name="system.ataques.{{index}}.formulaDanio" value="{{ataque.formulaDanio}}" placeholder="1d8" />
                                    <a class="roll-formula npc-roll-btn-damage" data-formula="{{ataque.formulaDanio}}" data-nombre="{{ataque.nombre}}" data-especial="{{ataque.especial}}" data-tipo="Daño" title="Probar Tirada de Daño">
                                        <i class="fas fa-dice-d20"></i>
                                    </a>
                                </div>
                            </div>

                            <div class="npc-attack-edit-special flexrow">
                                <label>Especial:</label>
                                <textarea name="system.ataques.{{index}}.especial" placeholder="Efectos adicionales, veneno, parálisis...">{{ataque.especial}}</textarea>
                            </div>
                        {{else}}
                            {{!-- MODO LECTURA --}}
                            <div class="npc-attack-read-row flexrow">
                                <div class="npc-attack-title-wrap flexrow">
                                    <span class="npc-attack-name">{{ataque.nombre}}</span>
                                    <span class="inventory-tag tag-weapon">{{ataque.tipo}}</span>
                                </div>

                                <div class="npc-attack-rolls-wrap flexrow">
                                    <a class="roll-formula npc-roll-pill npc-roll-pill-impact" data-formula="{{ataque.formulaAtaque}}" data-nombre="{{ataque.nombre}}" data-especial="{{ataque.especial}}" data-tipo="Impacto" title="Tirar Impacto ({{ataque.formulaAtaque}})">
                                        <i class="fas fa-crosshairs"></i>
                                        <span class="npc-roll-pill-label">Impacto</span>
                                        <span class="npc-roll-pill-formula">{{ataque.formulaAtaque}}</span>
                                    </a>

                                    <a class="roll-formula npc-roll-pill npc-roll-pill-damage" data-formula="{{ataque.formulaDanio}}" data-nombre="{{ataque.nombre}}" data-especial="{{ataque.especial}}" data-tipo="Daño" title="Tirar Daño ({{ataque.formulaDanio}})">
                                        <i class="fas fa-tint"></i>
                                        <span class="npc-roll-pill-label">Daño</span>
                                        <span class="npc-roll-pill-formula">{{ataque.formulaDanio}}</span>
                                    </a>
                                </div>
                            </div>

                            {{#if ataque.especial}}
                            <div class="npc-attack-special-note">
                                <i class="fas fa-sparkles"></i> <strong>Especial:</strong> {{ataque.especial}}
                            </div>
                            {{/if}}
                        {{/if}}
                    </div>
                    {{/each}}

                    {{#unless system.ataques.length}}
                    <div class="empty-placeholder">No hay ataques definidos para este PNJ.</div>
                    {{/unless}}
                </div>
            </div>

            {{!-- SECCIÓN 2: DESCRIPCIÓN Y LORE --}}
            <div class="footer-box notas npc-section-box flexcol">
                <h3><i class="fas fa-feather-alt"></i> Descripción y Lore</h3>
                <div class="parchment-panel notes-editor-panel npc-lore-panel">
                    {{editor enrichedDescription target="system.descripcion" button=true owner=owner editable=editable engine="prosemirror" collaborate=false}}
                </div>
            </div>

        </section>

    </section>

</form>
